{
  "name": "quiet-current-agentic-reflection",
  "description": "Local-first agentic reflection platform with journaling, guided practices, weekly reviews, and configurable AI guide personas.",
  "version": "1.0.0",
  "private": false,
  "type": "module",
  "_devWorkflow": "npm run dev = full stack (Vite + API); required for /api/* from the browser. dev:web proxies /api to API_PROXY_TARGET or http://127.0.0.1:3001 — run dev:api separately or match PORT/API_PROXY_TARGET. Stale node server or web-only dev causes Express 'Cannot POST /api/...'.",
  "engines": {
    "node": ">=20.0.0 <24.0.0"
  },
  "scripts": {
    "dev": "concurrently -k \"node server/index.js\" \"vite --host 127.0.0.1\"",
    "dev:web": "vite --host 127.0.0.1",
    "dev:api": "node server/index.js",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server/index.js",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test": "npm-run-all2 --parallel test:unit test:e2e",
    "installer:prepare": "powershell -ExecutionPolicy Bypass -File scripts/build-windows-installer.ps1",
    "installer:prepare:mac-email": "powershell -ExecutionPolicy Bypass -File scripts/prepare-macos-email-bundle.ps1",
    "dev:e2e": "concurrently -k \"node server/index.js\" \"vite --host 127.0.0.1 --port 5274\""
  },
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "cors": "^2.8.5",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.53.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^2.1.8",
    "concurrently": "^9.1.2",
    "jsdom": "^25.0.1",
    "npm-run-all2": "^8.0.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "supertest": "^7.1.0",
    "typescript": "^5.7.3",
    "vite": "^6.0.6",
    "vitest": "^2.1.8"
  },
  "keywords": [
    "react",
    "typescript",
    "vite",
    "express",
    "sqlite",
    "local-first",
    "ai",
    "journaling",
    "mindfulness"
  ],
  "author": "Yoseph Kant",
  "repository": {
    "type": "git",
    "url": "https://github.com/YosephKant/quiet-current-agentic-reflection.git"
  },
  "bugs": {
    "url": "https://github.com/YosephKant/quiet-current-agentic-reflection/issues"
  },
  "homepage": "https://github.com/YosephKant/quiet-current-agentic-reflection#readme"
}
