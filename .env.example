# API server
PORT=3001

# SQLite and migrations live here
DATA_DIR=./data

# Local Ollama (default chat backend)
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1
# If chat cannot reach the model: start Ollama, then `ollama pull llama3.1` (or your OLLAMA_MODEL name).

# ollama | openai
CHAT_MODE=ollama

# When CHAT_MODE=openai — any OpenAI-compatible API (e.g. Fireworks, Together)
# OPENAI_BASE_URL=https://api.fireworks.ai/inference/v1
# OPENAI_API_KEY=
# OPENAI_MODEL=accounts/fireworks/models/llama-v3p1-8b-instruct
